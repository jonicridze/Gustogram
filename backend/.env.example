# ==============================
#  Gustogram TMA — Backend ENV
# ==============================

PORT=3001

# Telegram Bot (создать через @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram chat ID для уведомлений персонала
# Узнать chat_id: добавь бота в группу, отправь сообщение, зайди на
# https://api.telegram.org/bot<TOKEN>/getUpdates — найди "chat":{"id":...}
STAFF_CHAT_NEVSKY=-100123456789
STAFF_CHAT_ENGELSA=-100987654321

# URL сайта для парсинга меню
SITE_NEVSKY_MENU=https://gustogram.ru/nmenu
SITE_ENGELSA_MENU=https://gustogram.ru/emenu

# PDF меню (бар — единственный читаемый PDF)
PDF_BAR_NEVSKY=https://gustogram.ru/menufile/1780303328_25.pdf
PDF_BAR_ENGELSA=https://gustogram.ru/menufile/1780303328_25.pdf

# Кэш меню в секундах (10 минут)
MENU_CACHE_TTL=600

# CORS — домен твоего фронтенда (после деплоя)
FRONTEND_URL=https://your-frontend.vercel.app
